{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtual MIDI Master",
  "version": "0.1.0",
  "identifier": "com.virtualmidimaster.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Virtual MIDI Master",
      "width": 1180,
      "height": 760,
      "minWidth": 850,
      "minHeight": 620,
      "backgroundColor": "#0b0d12"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["bin/virtual-midi-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "wix": { "language": "de-DE" } }
  }
}
